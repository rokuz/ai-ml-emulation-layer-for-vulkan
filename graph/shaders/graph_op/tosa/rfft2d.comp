layout(local_size_x = %warpX%) in;

layout(set = 0, binding = 0) uniform tensorARM<float, 3> outputRealData;
layout(set = 1, binding = 0) uniform tensorARM<float, 3> outputImagData;
layout(set = 2, binding = 0) uniform tensorARM<float, 3> inputData;

layout(constant_id = 0) const uint TILE_GROUPS = 1;
shared vec4 tileValues[TILE_GROUPS];

void main() {
    const uint N = tensorSizeARM(inputData, 0);
    const uint H = tensorSizeARM(inputData, 1);
    const uint W = tensorSizeARM(inputData, 2);
    const uint OW = tensorSizeARM(outputRealData, 2);

    const uint planeValues = H * OW;
    const uint tileBase = gl_GlobalInvocationID.x - gl_LocalInvocationID.x +
                          gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const uint totalValues = N * planeValues;
    if (tileBase >= totalValues) {
        return;
    }

    const uint offset = tileBase + gl_LocalInvocationID.x;
    const bool write = offset < totalValues;
    const uint element = write ? offset : tileBase;

    uint[3] index = uint[](element / planeValues, element / OW % H, element % OW);

    uint on = index[0];
    uint oy = index[1];
    uint ox = index[2];

    const uint rowGroups = (W + 3u) / 4u;
    const uint tileLast = min(tileBase + gl_WorkGroupSize.x, totalValues) - 1u;
    const uint tileRows = tileBase / planeValues == tileLast / planeValues ? TILE_GROUPS / rowGroups : 0u;
    const bool tiled = tileRows > 0u;
    const uint rowBlock = tiled ? tileRows : H;
    if (!write && !tiled) {
        return;
    }

    // Use Kahan summation to counteract cumulative errors in float summation
    float sumReal = 0.0;
    float sumImag = 0.0;
    precise float errorReal = 0.0;
    precise float errorImag = 0.0;

    bool skipImag = false;
    if (oy == 0 && (ox == 0 || ox == (W / 2))) {
        skipImag = true;
    } else if (oy == (H / 2) && (ox == 0 || ox == (W / 2))) {
        skipImag = true;
    }

    for (uint blockY = 0; blockY < H; blockY += rowBlock) {
        const uint rows = min(rowBlock, H - blockY);

        if (tiled) {
            barrier();
            for (uint group = gl_LocalInvocationID.x; group < rows * rowGroups; group += gl_WorkGroupSize.x) {
                const uint iy = blockY + group / rowGroups;
                const uint ix = group % rowGroups * 4u;

                float valueReal[4];
                tensorReadARM(inputData, uint[](on, iy, ix), valueReal);
                tileValues[group] = vec4(valueReal[0], valueReal[1], valueReal[2], valueReal[3]);
            }
            barrier();
        }

        uint group = 0;
        for (uint iy = blockY; iy < blockY + rows; iy++) {
            const uint rowTerm = iy * oy * W;

            for (uint ix = 0; ix < W; ix += 4, group++) {
                vec4 valueRealVec;
                if (tiled) {
                    valueRealVec = tileValues[group];
                } else {
                    float valueReal[4];
                    tensorReadARM(inputData, uint[](on, iy, ix), valueReal);
                    valueRealVec = vec4(valueReal[0], valueReal[1], valueReal[2], valueReal[3]);
                }

                vec4 ixs = vec4(ix, ix + 1, ix + 2, ix + 3);

                // Angles are fractional multiples of 2 pi with a fixed denominator.
                // Taking the numerators modulo the denominator maps the fractions to the range [0, 1),
                // giving angles in [0, 2 pi).
                // Mathematically this gives the same result for sin and cos but numerically it is
                // more accurate since we avoid large angles.
                vec4 angles = 2.0 * PI * mod(rowTerm + ixs * ox * H, W * H) / (W * H);

                // Compute next term in the sum and subtract the accumulated error from it
                float termReal = dot(valueRealVec, cos(angles)) - errorReal;
                // Compute new sum
                precise float sumNewReal = sumReal + termReal;
                // Compute new error; algebraically this is always 0
                errorReal = (sumNewReal - sumReal) - termReal;
                // Update sum
                sumReal = sumNewReal;

                if (!skipImag){
                    float termImag = dot(valueRealVec, -sin(angles)) - errorImag;
                    precise float sumNewImag = sumImag + termImag;
                    errorImag = (sumNewImag - sumImag) - termImag;
                    sumImag = sumNewImag;
                }
            }
        }
    }

    // Write output
    if (write) {
        tensorWriteARM(outputRealData, index, sumReal);
        tensorWriteARM(outputImagData, index, sumImag);
    }
}
