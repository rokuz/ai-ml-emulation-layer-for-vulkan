#define STORAGE_T %in_out_t%
#define TYPE_IN_OUT %in_out_t_type%
#define ACC_T %acc_t%
#define MIN %in_out_t_lowest%
#define MAX %in_out_t_max%

#define IN_OUT_T %in_out_t_comp%

layout(local_size_x = %warpX%) in;

layout(push_constant) uniform PushConstants {
    int32_t kernel[2];
    int32_t stride[2];
    int32_t pad[4];
    int32_t inputZeroPoint;
    int32_t outputZeroPoint;
} pushConstants;

layout(set = 0, binding = 0) uniform tensorARM<STORAGE_T, 4> outputData;
layout(set = 1, binding = 0) uniform tensorARM<STORAGE_T, 4> inputData;

void main() {
    uint[4] shape = uint[](tensorSizeARM(outputData, 0), tensorSizeARM(outputData, 1),
                          tensorSizeARM(outputData, 2), tensorSizeARM(outputData, 3));
    uint[4] index;
    getVectorIndex(index, shape)

    const uint on = index[0];
    const uint oy = index[1];
    const uint ox = index[2];
    const uint oc = index[3];

#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
    precise ACC_T acc[4] = ACC_T[4](ACC_T(0), ACC_T(0), ACC_T(0), ACC_T(0));
#else
    ACC_T acc[4] = ACC_T[4](ACC_T(0), ACC_T(0), ACC_T(0), ACC_T(0));
#endif
    uint32_t count = uint32_t(0);

    uint iy = oy * PUSH_INT(2, stride[0]) - PUSH_INT(4, pad[0]);
    uint ix = ox * PUSH_INT(3, stride[1]) - PUSH_INT(6, pad[2]);

    for (uint ky = 0; ky < PUSH_INT(0, kernel[0]); ky++) {
        for (uint kx = 0; kx < PUSH_INT(1, kernel[1]); kx++) {
            uint y = iy + ky;
            uint x = ix + kx;

            if (y < tensorSizeARM(inputData, 1) && x < tensorSizeARM(inputData, 2)) {
                STORAGE_T valueRaw[4];
                tensorReadARM(inputData, uint[](on, y, x, oc), valueRaw);

                for (uint k = 0; k < 4; k++) {
                    IN_OUT_T value = DECODE_STORAGE_TO_COMP(valueRaw[k], TYPE_IN_OUT, IN_OUT_T);

                    acc[k] += ACC_T(value) - ACC_T(PUSH_INT(8, inputZeroPoint));
                }
                count++;
            }
        }
    }

    STORAGE_T outValue[4];
    for (uint k = 0; k < 4; k++) {
#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
        acc[k] /= ACC_T(count);
#else
        // Divide and round
        ACC_T round = acc[k] < 0 ? -ACC_T(count >> 1) : ACC_T(count >> 1);
        acc[k] = (acc[k] + round) / ACC_T(count);

        // Add output zero point
        acc[k] += ACC_T(PUSH_INT(9, outputZeroPoint));

        // Clamp to output range
        acc[k] = clamp(acc[k], MIN, MAX);
#endif
        outValue[k] = ENCODE_COMP_TO_STORAGE(float(acc[k]), STORAGE_T, TYPE_IN_OUT);
    }

    tensorWriteARM(outputData, index, outValue);
}
