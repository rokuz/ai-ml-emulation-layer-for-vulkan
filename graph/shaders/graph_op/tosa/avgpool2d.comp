#define STORAGE_T %in_out_t%
#define TYPE_IN_OUT %in_out_t_type%
#define ACC_T %acc_t%
#define MIN %in_out_t_lowest%
#define MAX %in_out_t_max%

#define IN_OUT_T %in_out_t_comp%

layout(local_size_x = %warpX%) in;

layout(push_constant) uniform PushConstants {
    int32_t kernel[2];
    int32_t stride[2];
    int32_t pad[4];
    int32_t inputZeroPoint;
    int32_t outputZeroPoint;
} pushConstants;

layout(set = 0, binding = 0) uniform tensorARM<STORAGE_T, 4> outputData;
layout(set = 1, binding = 0) uniform tensorARM<STORAGE_T, 4> inputData;

void main() {
    const uint outputBatches = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_0 : tensorSizeARM(outputData, 0);
    const uint outputHeight = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_1 : tensorSizeARM(outputData, 1);
    const uint outputWidth = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_2 : tensorSizeARM(outputData, 2);
    const uint outputChannels = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_3 : tensorSizeARM(outputData, 3);
    const uint channelGroups = (outputChannels + 3u) / 4u;

    uint dispatchOffset = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const uint oc = (dispatchOffset % channelGroups) * 4u;
    dispatchOffset /= channelGroups;
    const uint ox = dispatchOffset % outputWidth;
    dispatchOffset /= outputWidth;
    const uint oy = dispatchOffset % outputHeight;
    dispatchOffset /= outputHeight;
    const uint on = dispatchOffset;
    if (on >= outputBatches) {
        return;
    }
    uint[4] index = uint[](on, oy, ox, oc);

#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
    precise ACC_T acc[4] = ACC_T[4](ACC_T(0), ACC_T(0), ACC_T(0), ACC_T(0));
#else
    ACC_T acc[4] = ACC_T[4](ACC_T(0), ACC_T(0), ACC_T(0), ACC_T(0));
#endif
    uint32_t count = uint32_t(0);

    uint iy = oy * (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_2, PUSH_WORD_3)[0] : pushConstants.stride[0]) - (PUSH_WORDS_VALID != 0 ? int[4](PUSH_WORD_4, PUSH_WORD_5, PUSH_WORD_6, PUSH_WORD_7)[0] : pushConstants.pad[0]);
    uint ix = ox * (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_2, PUSH_WORD_3)[1] : pushConstants.stride[1]) - (PUSH_WORDS_VALID != 0 ? int[4](PUSH_WORD_4, PUSH_WORD_5, PUSH_WORD_6, PUSH_WORD_7)[2] : pushConstants.pad[2]);

    for (uint ky = 0; ky < (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_0, PUSH_WORD_1)[0] : pushConstants.kernel[0]); ky++) {
        for (uint kx = 0; kx < (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_0, PUSH_WORD_1)[1] : pushConstants.kernel[1]); kx++) {
            uint y = iy + ky;
            uint x = ix + kx;

            if (y < tensorSizeARM(inputData, 1) && x < tensorSizeARM(inputData, 2)) {
                STORAGE_T valueRaw[4];
                tensorReadARM(inputData, uint[](on, y, x, oc), valueRaw);

                for (uint k = 0; k < 4; k++) {
                    IN_OUT_T value = DECODE_STORAGE_TO_COMP(valueRaw[k], TYPE_IN_OUT, IN_OUT_T);

                    acc[k] += ACC_T(value) - ACC_T((PUSH_WORDS_VALID != 0 ? PUSH_WORD_8 : pushConstants.inputZeroPoint));
                }
                count++;
            }
        }
    }

    STORAGE_T outValue[4];
    for (uint k = 0; k < 4; k++) {
#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
        acc[k] /= ACC_T(count);
#else
        // Divide and round
        ACC_T round = acc[k] < 0 ? -ACC_T(count >> 1) : ACC_T(count >> 1);
        acc[k] = (acc[k] + round) / ACC_T(count);

        // Add output zero point
        acc[k] += ACC_T((PUSH_WORDS_VALID != 0 ? PUSH_WORD_9 : pushConstants.outputZeroPoint));

        // Clamp to output range
        acc[k] = clamp(acc[k], MIN, MAX);
#endif
        outValue[k] = ENCODE_COMP_TO_STORAGE(float(acc[k]), STORAGE_T, TYPE_IN_OUT);
    }

    tensorWriteARM(outputData, index, outValue);
}
