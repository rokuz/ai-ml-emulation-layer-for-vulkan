#define STORAGE_T %in_out_t%
#define TYPE_IN_OUT %in_out_t_type%

#define IN_OUT_T %in_out_t_comp%

layout(local_size_x = %warpX%) in;

layout(push_constant) uniform PushConstants {
    int32_t kernel[2];
    int32_t stride[2];
    int32_t pad[4];
    uint nanMode;
} pushConstants;

layout(set = 0, binding = 0) uniform tensorARM<STORAGE_T, 4> outputData;
layout(set = 1, binding = 0) uniform tensorARM<STORAGE_T, 4> inputData;

void main() {
    const uint outputBatches = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_0 : tensorSizeARM(outputData, 0);
    const uint outputHeight = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_1 : tensorSizeARM(outputData, 1);
    const uint outputWidth = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_2 : tensorSizeARM(outputData, 2);
    const uint outputChannels = DISPATCH_RANK == 4u ? DISPATCH_SHAPE_3 : tensorSizeARM(outputData, 3);
    const uint channelGroups = (outputChannels + 3u) / 4u;

    uint dispatchOffset = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    const uint oc = (dispatchOffset % channelGroups) * 4u;
    dispatchOffset /= channelGroups;
    const uint ox = dispatchOffset % outputWidth;
    dispatchOffset /= outputWidth;
    const uint oy = dispatchOffset % outputHeight;
    dispatchOffset /= outputHeight;
    const uint on = dispatchOffset;
    if (on >= outputBatches) {
        return;
    }
    uint[4] index = uint[](on, oy, ox, oc);

    IN_OUT_T acc[4] = IN_OUT_T[4](IN_OUT_T(%in_out_t_lowest%), IN_OUT_T(%in_out_t_lowest%),
                                  IN_OUT_T(%in_out_t_lowest%), IN_OUT_T(%in_out_t_lowest%));
#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
    bool nanSeen[4] = bool[4](false, false, false, false);
    IN_OUT_T nanValue[4];
#endif

    // Keep math in signed domain for signed push constants and cast only after bounds checks.
    int kernelY = max((PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_0, PUSH_WORD_1)[0] : pushConstants.kernel[0]), 0);
    int kernelX = max((PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_0, PUSH_WORD_1)[1] : pushConstants.kernel[1]), 0);
    int strideY = max((PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_2, PUSH_WORD_3)[0] : pushConstants.stride[0]), 1);
    int strideX = max((PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_2, PUSH_WORD_3)[1] : pushConstants.stride[1]), 1);

    int iy = int(oy) * strideY - (PUSH_WORDS_VALID != 0 ? int[4](PUSH_WORD_4, PUSH_WORD_5, PUSH_WORD_6, PUSH_WORD_7)[0] : pushConstants.pad[0]);
    int ix = int(ox) * strideX - (PUSH_WORDS_VALID != 0 ? int[4](PUSH_WORD_4, PUSH_WORD_5, PUSH_WORD_6, PUSH_WORD_7)[2] : pushConstants.pad[2]);

    for (int ky = 0; ky < kernelY; ++ky) {
        for (int kx = 0; kx < kernelX; ++kx) {
            int y = iy + ky;
            int x = ix + kx;

            if (y >= 0 && x >= 0 && uint(y) < tensorSizeARM(inputData, 1) && uint(x) < tensorSizeARM(inputData, 2)) {
                STORAGE_T valueRaw[4];
                tensorReadARM(inputData, uint[](on, uint(y), uint(x), oc), valueRaw);

                for (uint k = 0; k < 4; k++) {
                    IN_OUT_T value = DECODE_STORAGE_TO_COMP(valueRaw[k], TYPE_IN_OUT, IN_OUT_T);

#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
                    if (isnan(value)) {
                        if ((PUSH_WORDS_VALID != 0 ? uint(PUSH_WORD_8) : pushConstants.nanMode) == NAN_MODE_IGNORE) {
                            // Ignore value and continue
                            continue;
                        }
                        // If any value is NaN, then the result must be NaN
                        if (!nanSeen[k]) {
                            nanSeen[k] = true;
                            nanValue[k] = value;
                        }
                        continue;
                    }
#endif
                    acc[k] = max(acc[k], value);
                }
            }
        }
    }

    STORAGE_T outValue[4];
    for (uint k = 0; k < 4; k++) {
#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
        outValue[k] = ENCODE_COMP_TO_STORAGE(nanSeen[k] ? nanValue[k] : acc[k], STORAGE_T, TYPE_IN_OUT);
#else
        outValue[k] = ENCODE_COMP_TO_STORAGE(acc[k], STORAGE_T, TYPE_IN_OUT);
#endif
    }

    tensorWriteARM(outputData, index, outValue);
}
