#define STORAGE_T %in_out_t%
#define TYPE_IN_OUT %in_out_t_type%

#define IN_OUT_T %in_out_t_comp%

layout(local_size_x = %warpX%) in;

layout(push_constant) uniform PushConstants {
    int32_t kernel[2];
    int32_t stride[2];
    int32_t pad[4];
    uint nanMode;
} pushConstants;

layout(set = 0, binding = 0) uniform tensorARM<STORAGE_T, 4> outputData;
layout(set = 1, binding = 0) uniform tensorARM<STORAGE_T, 4> inputData;

void main() {
    uint[4] shape = uint[](tensorSizeARM(outputData, 0), tensorSizeARM(outputData, 1),
                          tensorSizeARM(outputData, 2), tensorSizeARM(outputData, 3));
    uint[4] index;
    getVectorIndex(index, shape)

    const uint on = index[0];
    const uint oy = index[1];
    const uint ox = index[2];
    const uint oc = index[3];

    IN_OUT_T acc[4] = IN_OUT_T[4](IN_OUT_T(%in_out_t_lowest%), IN_OUT_T(%in_out_t_lowest%),
                                  IN_OUT_T(%in_out_t_lowest%), IN_OUT_T(%in_out_t_lowest%));
#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
    bool nanSeen[4] = bool[4](false, false, false, false);
    IN_OUT_T nanValue[4];
#endif

    // Keep math in signed domain for signed push constants and cast only after bounds checks.
    int kernelY = max(PUSH_INT(0, kernel[0]), 0);
    int kernelX = max(PUSH_INT(1, kernel[1]), 0);
    int strideY = max(PUSH_INT(2, stride[0]), 1);
    int strideX = max(PUSH_INT(3, stride[1]), 1);

    int iy = int(oy) * strideY - PUSH_INT(4, pad[0]);
    int ix = int(ox) * strideX - PUSH_INT(6, pad[2]);

    for (int ky = 0; ky < kernelY; ++ky) {
        for (int kx = 0; kx < kernelX; ++kx) {
            int y = iy + ky;
            int x = ix + kx;

            if (y >= 0 && x >= 0 && uint(y) < tensorSizeARM(inputData, 1) && uint(x) < tensorSizeARM(inputData, 2)) {
                STORAGE_T valueRaw[4];
                tensorReadARM(inputData, uint[](on, uint(y), uint(x), oc), valueRaw);

                for (uint k = 0; k < 4; k++) {
                    IN_OUT_T value = DECODE_STORAGE_TO_COMP(valueRaw[k], TYPE_IN_OUT, IN_OUT_T);

#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
                    if (isnan(value)) {
                        if (PUSH_UINT(8, nanMode) == NAN_MODE_IGNORE) {
                            // Ignore value and continue
                            continue;
                        }
                        // If any value is NaN, then the result must be NaN
                        if (!nanSeen[k]) {
                            nanSeen[k] = true;
                            nanValue[k] = value;
                        }
                        continue;
                    }
#endif
                    acc[k] = max(acc[k], value);
                }
            }
        }
    }

    STORAGE_T outValue[4];
    for (uint k = 0; k < 4; k++) {
#if IS_FLOAT(TYPE_IN_OUT) || IS_REDUCED_FLOAT(TYPE_IN_OUT)
        outValue[k] = ENCODE_COMP_TO_STORAGE(nanSeen[k] ? nanValue[k] : acc[k], STORAGE_T, TYPE_IN_OUT);
#else
        outValue[k] = ENCODE_COMP_TO_STORAGE(acc[k], STORAGE_T, TYPE_IN_OUT);
#endif
    }

    tensorWriteARM(outputData, index, outValue);
}
