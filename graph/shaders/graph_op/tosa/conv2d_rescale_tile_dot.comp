#define IN_T %in_t%
#define OUT_T %out_t%
#define TAIL_OUT_T %tail_out_t%
#define TAIL_MUL_T %tail_mul_t%
#define WEIGHT_T %weight_t%
#define TYPE_IN %in_t_type%
#define TYPE_OUT %out_t_type%
#define TYPE_ACC %acc_t_type%
#define ACC_T %acc_t%

DEFINE_CONV_ACC_CASTS(ACC_T, OUT_T, TYPE_IN, TYPE_OUT)

#if TYPE_ACC == TYPE_INT64
    #define VEC4 i64vec4
#elif TYPE_ACC == TYPE_INT32
    #define VEC4 ivec4
#else
    #define VEC4 vec4
#endif

layout(local_size_x = %warpX%, local_size_y = %warpY%, local_size_z_id = 7) in;

layout(push_constant) uniform PushConstants {
    int32_t inputZeroPoint;
    int32_t weightZeroPoint;
    int32_t pad[4];
    int32_t stride[2];
    int32_t dilation[2];
} pushConstants;

layout(set = 0, binding = 0) uniform tensorARM<TAIL_OUT_T, 4> outputData;
layout(set = 1, binding = 0) uniform tensorARM<IN_T, 4> inputData;
layout(set = 2, binding = 0) uniform tensorARM<WEIGHT_T, 4> weightsData;
layout(set = 3, binding = 0) uniform tensorARM<OUT_T, 1> biasesData;

layout(constant_id = 0) const uint32_t TAIL_SCALE32 = 0;
layout(constant_id = 1) const uint32_t TAIL_DOUBLE_ROUND = 0;
layout(constant_id = 2) const uint32_t TAIL_PER_CHANNEL = 0;
layout(constant_id = 3) const int32_t TAIL_INPUT_ZERO_POINT = 0;
layout(constant_id = 4) const int32_t TAIL_OUTPUT_ZERO_POINT = 0;

layout(set = 4, binding = 0) uniform tensorARM<TAIL_MUL_T, 1> tailMultiplier;
layout(set = 5, binding = 0) uniform tensorARM<int8_t, 1> tailShift;

int32_t tailApplyScale(int64_t value, int32_t multiplier, int8_t shift, bool doubleRound) {
    int64_t round = int64_t(1) << (shift - 1);

    if (doubleRound) {
        if (shift > 31) {
            if (value >= 0) {
                round += 1 << 30;
            }
            else {
                round -= 1 << 30;
            }
        }
    }

    int64_t result = value * multiplier;
    result += round;
    result >>= shift;

    return int32_t(result);
}

#define rescaleTail(inValue, channel, outValue)                                                                        \
    {                                                                                                                  \
        const uint tailChannel = TAIL_PER_CHANNEL != 0 ? uint(channel) : uint(0);                                      \
        const int64_t tailInput = int64_t(inValue) - int64_t(OUT_T(TAIL_INPUT_ZERO_POINT));                            \
        TAIL_MUL_T tailMultiplierValue;                                                                                \
        tensorReadARM(tailMultiplier, uint[1](tailChannel), tailMultiplierValue);                                      \
        int8_t tailShiftValue;                                                                                         \
        tensorReadARM(tailShift, uint[1](tailChannel), tailShiftValue);                                                \
        int32_t tailResult = tailApplyScale(tailInput, int32_t(tailMultiplierValue), tailShiftValue,                   \
                                            TAIL_SCALE32 != 0 && TAIL_DOUBLE_ROUND != 0);                              \
        tailResult += TAIL_OUT_T(TAIL_OUTPUT_ZERO_POINT);                                                              \
        tailResult = int32_t(clamp(tailResult, TAIL_OUT_T(%tail_out_t_lowest%), TAIL_OUT_T(%tail_out_t_max%)));        \
        outValue = TAIL_OUT_T(tailResult);                                                                             \
    }

layout(constant_id = 5) const uint TILE_INPUT_WORDS = 1;
layout(constant_id = 6) const uint TILE_WEIGHT_WORDS = 1;
shared uint tileInput[TILE_INPUT_WORDS];
shared uint tileWeights[TILE_WEIGHT_WORDS];
layout(constant_id = 8) const uint TILE_GROUPS = 1;
shared int tileWeightSums[4 * TILE_GROUPS];

#define TILE_ONES 0x01010101

#define TILE_PIXELS %tile_pixels%u


uint packTileWord(int a, int b, int c, int d) {
    return uint(a & 255) | (uint(b & 255) << 8) | (uint(c & 255) << 16) | (uint(d & 255) << 24);
}

void main() {
    const uint outputChannels = tensorSizeARM(outputData, 3);
    const uint tileGroups = gl_WorkGroupSize.z;
    const uint channelGroups = (outputChannels + 3u) / 4u;
    const uint batchGroups = (channelGroups + tileGroups - 1u) / tileGroups * tileGroups;
    const uint n = gl_GlobalInvocationID.z / batchGroups;
    const uint oc = (gl_GlobalInvocationID.z - n * batchGroups) * 4u;
    const uint tileChannel = (gl_WorkGroupID.z * tileGroups - n * batchGroups) * 4u;
    const uint oxBase = gl_WorkGroupID.x * gl_WorkGroupSize.x * TILE_PIXELS + gl_LocalInvocationID.x;
    const uint oy = gl_GlobalInvocationID.y;

    const int inputZeroPoint = PUSH_WORDS_VALID != 0 ? PUSH_WORD_0 : pushConstants.inputZeroPoint;
    const int weightZeroPoint = PUSH_WORDS_VALID != 0 ? PUSH_WORD_1 : pushConstants.weightZeroPoint;
    const int padTop = PUSH_WORDS_VALID != 0 ? PUSH_WORD_2 : pushConstants.pad[0];
    const int padLeft = PUSH_WORDS_VALID != 0 ? PUSH_WORD_4 : pushConstants.pad[2];
    const uint strideY = uint(PUSH_WORDS_VALID != 0 ? PUSH_WORD_6 : pushConstants.stride[0]);
    const uint strideX = uint(PUSH_WORDS_VALID != 0 ? PUSH_WORD_7 : pushConstants.stride[1]);
    const uint dilationY = uint(PUSH_WORDS_VALID != 0 ? PUSH_WORD_8 : pushConstants.dilation[0]);
    const uint dilationX = uint(PUSH_WORDS_VALID != 0 ? PUSH_WORD_9 : pushConstants.dilation[1]);

    const uint inputHeight = tensorSizeARM(inputData, 1);
    const uint inputWidth = tensorSizeARM(inputData, 2);
    const uint inputChannels = tensorSizeARM(inputData, 3);
    const uint kernelHeight = tensorSizeARM(weightsData, 1);
    const uint kernelWidth = tensorSizeARM(weightsData, 2);
    const uint words = (inputChannels + 3u) / 4u;
    const uint tileHeight = (gl_WorkGroupSize.y - 1u) * strideY + (kernelHeight - 1u) * dilationY + 1u;
    const uint tileWidth = (gl_WorkGroupSize.x * TILE_PIXELS - 1u) * strideX + (kernelWidth - 1u) * dilationX + 1u;
    const uint tilePixels = tileHeight * tileWidth;
    const uint kernelCells = kernelHeight * kernelWidth;
    const uint cellWords = kernelCells * words;
    const uint threads = gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;

    const int tileY = int(gl_WorkGroupID.y * gl_WorkGroupSize.y * strideY) - padTop;
    const int tileX = int(gl_WorkGroupID.x * gl_WorkGroupSize.x * TILE_PIXELS * strideX) - padLeft;
    const uint paddingWord = packTileWord(inputZeroPoint, inputZeroPoint, inputZeroPoint, inputZeroPoint);
    for (uint p = gl_LocalInvocationIndex; p < tilePixels; p += threads) {
        const uint ty = p / tileWidth;
        const int y = tileY + int(ty);
        const int x = tileX + int(p - ty * tileWidth);
        if (uint(y) < inputHeight && uint(x) < inputWidth) {
            for (uint word = 0u; word < words; word++) {
                const uint ic = word * 4u;
                IN_T value[4];
                tensorReadARM(inputData, uint[](n, uint(y), uint(x), ic), value);
                tileInput[word * tilePixels + p] = packTileWord(int(value[0]),
                                                                ic + 1u < inputChannels ? int(value[1]) : inputZeroPoint,
                                                                ic + 2u < inputChannels ? int(value[2]) : inputZeroPoint,
                                                                ic + 3u < inputChannels ? int(value[3]) : inputZeroPoint);
            }
        } else {
            for (uint word = 0u; word < words; word++) {
                tileInput[word * tilePixels + p] = paddingWord;
            }
        }
    }

    if (gl_LocalInvocationIndex < 4u * tileGroups) {
        tileWeightSums[gl_LocalInvocationIndex] = 0;
    }
    barrier();

    const uint weightPaddingWord = packTileWord(weightZeroPoint, weightZeroPoint, weightZeroPoint, weightZeroPoint);
    for (uint cell = gl_LocalInvocationIndex; cell < 4u * tileGroups * kernelCells; cell += threads) {
        const uint k = cell / kernelCells;
        const uint position = cell - k * kernelCells;
        const uint ky = position / kernelWidth;
        const uint kx = position - ky * kernelWidth;
        const uint base = k * cellWords + position * words;
        int weightSum = 0;
        if (tileChannel + k < outputChannels) {
            for (uint word = 0u; word < words; word++) {
                WEIGHT_T weight[4];
                tensorReadARM(weightsData, uint[](tileChannel + k, ky, kx, word * 4u), weight);
                const uint packed = packTileWord(int(weight[0]), int(weight[1]), int(weight[2]), int(weight[3]));
                tileWeights[base + word] = packed;
                weightSum += dotPacked4x8EXT(int(packed), TILE_ONES);
            }
        } else {
            for (uint word = 0u; word < words; word++) {
                tileWeights[base + word] = weightPaddingWord;
                weightSum += dotPacked4x8EXT(int(weightPaddingWord), TILE_ONES);
            }
        }
        atomicAdd(tileWeightSums[k], weightSum);
    }

    barrier();

    if (oy >= tensorSizeARM(outputData, 1) || oxBase >= tensorSizeARM(outputData, 2) || oc >= outputChannels) {
        return;
    }

    const uint ly = gl_LocalInvocationID.y;
    const uint lx = gl_LocalInvocationID.x;
    ivec4 acc[TILE_PIXELS];
    int inputSum[TILE_PIXELS];
    for (uint p = 0u; p < TILE_PIXELS; p++) {
        acc[p] = ivec4(0);
        inputSum[p] = 0;
    }
    const uint pixelStride = gl_WorkGroupSize.x * strideX;
    for (uint ky = 0u; ky < kernelHeight; ky++) {
        const uint row = (ly * strideY + ky * dilationY) * tileWidth + lx * strideX;
        for (uint kx = 0u; kx < kernelWidth; kx++) {
            const uint inputPixel = row + kx * dilationX;
            const uint weightBase = (ky * kernelWidth + kx) * words;
            for (uint word = 0u; word < words; word++) {
                const uint weightWord = gl_LocalInvocationID.z * 4u * cellWords + weightBase + word;
                const int w0 = int(tileWeights[weightWord]);
                const int w1 = int(tileWeights[cellWords + weightWord]);
                const int w2 = int(tileWeights[2u * cellWords + weightWord]);
                const int w3 = int(tileWeights[3u * cellWords + weightWord]);
                for (uint p = 0u; p < TILE_PIXELS; p++) {
                    const int value = int(tileInput[word * tilePixels + inputPixel + p * pixelStride]);
                    inputSum[p] += dotPacked4x8EXT(value, TILE_ONES);
                    acc[p] += ivec4(dotPacked4x8EXT(value, w0), dotPacked4x8EXT(value, w1),
                                    dotPacked4x8EXT(value, w2), dotPacked4x8EXT(value, w3));
                }
            }
        }
    }

    const uint sumBase = gl_LocalInvocationID.z * 4u;
    const int slots = int(kernelCells * words * 4u);
    const ivec4 weightSums = ivec4(tileWeightSums[sumBase], tileWeightSums[sumBase + 1u], tileWeightSums[sumBase + 2u],
                                   tileWeightSums[sumBase + 3u]);

    ivec4 biasValue;
    if (tensorSizeARM(biasesData, 0) == 1) {
        OUT_T bias;
        tensorReadARM(biasesData, uint[](0), bias);
        biasValue = ivec4(to_acc(bias));
    } else {
        OUT_T bias[4];
        tensorReadARM(biasesData, uint[](oc), bias);
        biasValue = ivec4(to_acc(bias[0]), to_acc(bias[1]), to_acc(bias[2]), to_acc(bias[3]));
    }

    const uint outputWidth = tensorSizeARM(outputData, 2);
    for (uint p = 0u; p < TILE_PIXELS; p++) {
        const uint ox = oxBase + p * gl_WorkGroupSize.x;
        if (ox >= outputWidth) {
            break;
        }
        ivec4 sum = acc[p];
        sum -= weightZeroPoint * inputSum[p];
        sum -= inputZeroPoint * weightSums;
        sum += slots * inputZeroPoint * weightZeroPoint;
        sum += biasValue;

        uint index[] = {n, oy, ox, oc};
        OUT_T outData[4] = OUT_T[](acc_to_out(sum[0], OUT_T(0)), acc_to_out(sum[1], OUT_T(0)),
                                   acc_to_out(sum[2], OUT_T(0)), acc_to_out(sum[3], OUT_T(0)));
        TAIL_OUT_T tailData[4];
        for (uint tailIndex = 0; tailIndex < 4; tailIndex++) {
            rescaleTail(outData[tailIndex], oc + tailIndex, tailData[tailIndex])
        }
        tensorWriteARM(outputData, index, tailData);
    }
}
