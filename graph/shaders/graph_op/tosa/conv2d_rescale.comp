#define IN_T %in_t%
#define OUT_T %out_t%
#define TAIL_OUT_T %tail_out_t%
#define TAIL_MUL_T %tail_mul_t%
#define WEIGHT_T %weight_t%
#define TYPE_IN %in_t_type%
#define TYPE_WEIGHT %weight_t_type%
#define TYPE_OUT %out_t_type%
#define TYPE_ACC %acc_t_type%
#define ACC_T %acc_t%


#if TYPE_ACC == TYPE_INT64
    #define VEC4 i64vec4
#elif TYPE_ACC == TYPE_INT32
    #define VEC4 ivec4
#else
    #define VEC4 vec4
#endif

layout(local_size_x = %warpX%, local_size_y = %warpY%, local_size_z = %warpZ%) in;

layout(push_constant) uniform PushConstants {
    int32_t inputZeroPoint;
    int32_t weightZeroPoint;
    int32_t pad[4];
    int32_t stride[2];
    int32_t dilation[2];
    uint32_t outputPositionOffset[3];
} pushConstants;

layout(set = 0, binding = 0) uniform tensorARM<TAIL_OUT_T, 4> outputData;
layout(set = 1, binding = 0) uniform tensorARM<IN_T, 4> inputData;
layout(set = 2, binding = 0) uniform tensorARM<WEIGHT_T, 4> weightsData;
layout(set = 3, binding = 0) uniform tensorARM<OUT_T, 1> biasesData;

layout(constant_id = 0) const uint32_t TAIL_SCALE32 = 0;
layout(constant_id = 1) const uint32_t TAIL_DOUBLE_ROUND = 0;
layout(constant_id = 2) const uint32_t TAIL_PER_CHANNEL = 0;
layout(constant_id = 3) const int32_t TAIL_INPUT_ZERO_POINT = 0;
layout(constant_id = 4) const int32_t TAIL_OUTPUT_ZERO_POINT = 0;

layout(set = 4, binding = 0) uniform tensorARM<TAIL_MUL_T, 1> tailMultiplier;
layout(set = 5, binding = 0) uniform tensorARM<int8_t, 1> tailShift;

int32_t tailApplyScale(int64_t value, int32_t multiplier, int8_t shift, bool doubleRound) {
    int64_t round = int64_t(1) << (shift - 1);

    if (doubleRound) {
        if (shift > 31) {
            if (value >= 0) {
                round += 1 << 30;
            }
            else {
                round -= 1 << 30;
            }
        }
    }

    int64_t result = value * multiplier;
    result += round;
    result >>= shift;

    return int32_t(result);
}

#define rescaleTail(inValue, channel, outValue)                                                                        \
    {                                                                                                                  \
        const uint tailChannel = TAIL_PER_CHANNEL != 0 ? uint(channel) : uint(0);                                      \
        const int64_t tailInput = int64_t(inValue) - int64_t(OUT_T(TAIL_INPUT_ZERO_POINT));                            \
        TAIL_MUL_T tailMultiplierValue;                                                                                \
        tensorReadARM(tailMultiplier, uint[1](tailChannel), tailMultiplierValue);                                      \
        int8_t tailShiftValue;                                                                                         \
        tensorReadARM(tailShift, uint[1](tailChannel), tailShiftValue);                                                \
        int32_t tailResult = tailApplyScale(tailInput, int32_t(tailMultiplierValue), tailShiftValue,                   \
                                            TAIL_SCALE32 != 0 && TAIL_DOUBLE_ROUND != 0);                              \
        tailResult += TAIL_OUT_T(TAIL_OUTPUT_ZERO_POINT);                                                              \
        tailResult = int32_t(clamp(tailResult, TAIL_OUT_T(%tail_out_t_lowest%), TAIL_OUT_T(%tail_out_t_max%)));        \
        outValue = TAIL_OUT_T(tailResult);                                                                             \
    }

void main() {
    ACC_T acc[4] = {ACC_T(0), ACC_T(0), ACC_T(0), ACC_T(0)};
    uint batches = tensorSizeARM(outputData, 0);
    uint batchWidth = pushConstants.outputPositionOffset[0] + gl_GlobalInvocationID.x;
    uint n = batchWidth % batches;
    uint ox = batchWidth / batches;
    uint oy = pushConstants.outputPositionOffset[1] + gl_GlobalInvocationID.y;
    uint oc = pushConstants.outputPositionOffset[2] + gl_GlobalInvocationID.z * 4;
    uint[4] ocs = {oc, oc + 1, oc + 2, oc + 3};

    if (oy >= tensorSizeARM(outputData, 1) ||
        ox >= tensorSizeARM(outputData, 2) ||
        oc >= tensorSizeARM(outputData, 3)) {
        return;
    }

    uint iy = oy * (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_6, PUSH_WORD_7)[0] : pushConstants.stride[0]) - (PUSH_WORDS_VALID != 0 ? int[4](PUSH_WORD_2, PUSH_WORD_3, PUSH_WORD_4, PUSH_WORD_5)[0] : pushConstants.pad[0]);
    uint ix = ox * (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_6, PUSH_WORD_7)[1] : pushConstants.stride[1]) - (PUSH_WORDS_VALID != 0 ? int[4](PUSH_WORD_2, PUSH_WORD_3, PUSH_WORD_4, PUSH_WORD_5)[2] : pushConstants.pad[2]);

    for (uint ky = 0; ky < tensorSizeARM(weightsData, 1); ky++) {
        for (uint kx = 0; kx < tensorSizeARM(weightsData, 2); kx++) {
            uint y = iy + ky * (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_8, PUSH_WORD_9)[0] : pushConstants.dilation[0]);
            uint x = ix + kx * (PUSH_WORDS_VALID != 0 ? int[2](PUSH_WORD_8, PUSH_WORD_9)[1] : pushConstants.dilation[1]);

            if (y < tensorSizeARM(inputData, 1) && x < tensorSizeARM(inputData, 2)) {
                const uint IC = tensorSizeARM(inputData, 3);
                for (uint ic = 0; ic < IC; ic += 4) {
                    IN_T tempValue[4];
                    tensorReadARM(inputData, uint[](n, y, x, ic), tempValue);
                    VEC4 value = VEC4(CONV_TO_ACC_INPUT(tempValue[0]), CONV_TO_ACC_INPUT(tempValue[1]), CONV_TO_ACC_INPUT(tempValue[2]), CONV_TO_ACC_INPUT(tempValue[3]));

                    WEIGHT_T weight[4][4];
                    tensorReadARM(weightsData, uint[](ocs[0], ky, kx, ic), weight[0]);
                    tensorReadARM(weightsData, uint[](ocs[1], ky, kx, ic), weight[1]);
                    tensorReadARM(weightsData, uint[](ocs[2], ky, kx, ic), weight[2]);
                    tensorReadARM(weightsData, uint[](ocs[3], ky, kx, ic), weight[3]);

                    VEC4 outValue = value - (PUSH_WORDS_VALID != 0 ? PUSH_WORD_0 : pushConstants.inputZeroPoint);
                    VEC4 outWeight0 = VEC4(CONV_TO_ACC_WEIGHT(weight[0][0]), CONV_TO_ACC_WEIGHT(weight[0][1]), CONV_TO_ACC_WEIGHT(weight[0][2]), CONV_TO_ACC_WEIGHT(weight[0][3])) - (PUSH_WORDS_VALID != 0 ? PUSH_WORD_1 : pushConstants.weightZeroPoint);
                    VEC4 outWeight1 = VEC4(CONV_TO_ACC_WEIGHT(weight[1][0]), CONV_TO_ACC_WEIGHT(weight[1][1]), CONV_TO_ACC_WEIGHT(weight[1][2]), CONV_TO_ACC_WEIGHT(weight[1][3])) - (PUSH_WORDS_VALID != 0 ? PUSH_WORD_1 : pushConstants.weightZeroPoint);
                    VEC4 outWeight2 = VEC4(CONV_TO_ACC_WEIGHT(weight[2][0]), CONV_TO_ACC_WEIGHT(weight[2][1]), CONV_TO_ACC_WEIGHT(weight[2][2]), CONV_TO_ACC_WEIGHT(weight[2][3])) - (PUSH_WORDS_VALID != 0 ? PUSH_WORD_1 : pushConstants.weightZeroPoint);
                    VEC4 outWeight3 = VEC4(CONV_TO_ACC_WEIGHT(weight[3][0]), CONV_TO_ACC_WEIGHT(weight[3][1]), CONV_TO_ACC_WEIGHT(weight[3][2]), CONV_TO_ACC_WEIGHT(weight[3][3])) - (PUSH_WORDS_VALID != 0 ? PUSH_WORD_1 : pushConstants.weightZeroPoint);

                    VEC4 mul0 = outValue * outWeight0;
                    VEC4 mul1 = outValue * outWeight1;
                    VEC4 mul2 = outValue * outWeight2;
                    VEC4 mul3 = outValue * outWeight3;
                    for (uint idx = 0; idx < 4 && ic + idx < IC; ++idx) {
                        acc[0] += ACC_T(mul0[idx]);
                        acc[1] += ACC_T(mul1[idx]);
                        acc[2] += ACC_T(mul2[idx]);
                        acc[3] += ACC_T(mul3[idx]);
                    }
                }
            }
        }
    }

    if (tensorSizeARM(biasesData, 0) == 1) {
        OUT_T bias;
        tensorReadARM(biasesData, uint[](0), bias);
        acc[0] += CONV_TO_ACC_BIAS(bias);
        acc[1] += CONV_TO_ACC_BIAS(bias);
        acc[2] += CONV_TO_ACC_BIAS(bias);
        acc[3] += CONV_TO_ACC_BIAS(bias);
    } else {
        OUT_T bias[4];
        tensorReadARM(biasesData, uint[](oc), bias);
        acc[0] += CONV_TO_ACC_BIAS(bias[0]);
        acc[1] += CONV_TO_ACC_BIAS(bias[1]);
        acc[2] += CONV_TO_ACC_BIAS(bias[2]);
        acc[3] += CONV_TO_ACC_BIAS(bias[3]);
    }
    uint index[] = {n, oy, ox, oc};
    OUT_T outData[4] = OUT_T[](CONV_ACC_TO_OUT(acc[0]), CONV_ACC_TO_OUT(acc[1]), CONV_ACC_TO_OUT(acc[2]), CONV_ACC_TO_OUT(acc[3]));
    TAIL_OUT_T tailData[4];
    for (uint tailIndex = 0; tailIndex < 4; tailIndex++) {
        rescaleTail(outData[tailIndex], oc + tailIndex, tailData[tailIndex])
    }
    tensorWriteARM(outputData, index, tailData);
}
